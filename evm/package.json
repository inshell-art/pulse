{
  "name": "pulse-evm",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "estimate:deploy:cost": "hardhat run scripts/estimate-deploy-cost.js",
    "benchmark:core:generate": "node scripts/generate-embedded-control.js --write",
    "benchmark:core": "node scripts/generate-embedded-control.js && hardhat run --config hardhat.benchmark.config.js scripts/benchmark-core.js",
    "benchmark:core:optimized": "node scripts/generate-embedded-control.js && hardhat run --config hardhat.benchmark-optimized.config.js scripts/benchmark-core.js",
    "test:core:release": "hardhat test --config hardhat.core-release.config.js",
    "check:core:release": "hardhat run --config hardhat.core-release.config.js scripts/check-core-release.js",
    "rehearse:core:local": "hardhat run --config hardhat.core-release.config.js scripts/rehearse-core-release.js",
    "rehearse:core:anvil": "hardhat run --config hardhat.core-release.config.js scripts/rehearse-core-release.js --network anvil",
    "prepare:core:deployment": "node scripts/prepare-core-deployment.js",
    "verify:core:deployment": "node scripts/verify-core-deployment.js",
    "deploy:core:sepolia": "node scripts/deploy-core-sepolia.js",
    "rehearse:core:sepolia": "hardhat run --config hardhat.core-release.config.js scripts/rehearse-core-sepolia.js",
    "verify:core:sepolia:explorer": "node scripts/verify-core-sepolia-explorer.js",
    "finalize:core:sepolia": "node scripts/finalize-core-sepolia-release.js",
    "deploy:local:eth": "hardhat run scripts/deploy-local-eth.js --network localhost",
    "smoke:local:eth": "hardhat run scripts/smoke-local-eth.js --network localhost",
    "scenario:local:eth": "hardhat run scripts/scenario-cascade-local-eth.js --network localhost",
    "local:eth": "npm run deploy:local:eth && npm run smoke:local:eth && npm run scenario:local:eth"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.2",
    "hardhat": "^3.1.8"
  }
}
