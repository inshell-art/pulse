{
  "name": "pulse-site",
  "main": "worker.js",
  "compatibility_date": "2026-05-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pulse.inshell.art", "custom_domain": true }],
  "assets": {
    "directory": "../../output/pulse-site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": false,
    "issues": { "enabled": true },
    "logs": { "enabled": false },
    "traces": { "enabled": false }
  },
  "build": { "command": "node build-site.js" },
  // Proposed destination only; provisioning and deployment require approval.
  "env": {
    "staging": {
      "name": "pulse-site-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "pulse-staging.inshell.art", "custom_domain": true }],
      "assets": {
        "directory": "../../output/pulse-site",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "none",
        "not_found_handling": "none"
      },
      "observability": {
        "enabled": false,
        "issues": { "enabled": true },
        "logs": { "enabled": false },
        "traces": { "enabled": false }
      }
    }
  }
}
