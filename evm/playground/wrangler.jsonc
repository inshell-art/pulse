{
  "name": "pulse-site",
  "main": "worker.js",
  "compatibility_date": "2026-05-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pulse.inshell.art", "custom_domain": true }],
  "assets": {
    "directory": "../../output/pulse-site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": false },
  "build": { "command": "node build-site.js" }
}
